<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Auth and TLS/certificate settings live together: both are "how do I lock this down"
         questions, and someone setting up access control wants to see all of it in one place
         rather than hunting across two separate sections. -->
    <PreferenceCategory
        android:title="Security">
        <CheckBoxPreference
            android:key="enable_auth"
            android:title="Enable Authentication"
            android:summary="Require username/password to access the stream"
            android:defaultValue="true" />
        <EditTextPreference
            android:key="username"
            android:title="Username"
            android:defaultValue=""
            android:singleLine="true" />
        <EditTextPreference
            android:key="password"
            android:title="Password"
            android:defaultValue=""
            android:inputType="textPassword"
            android:singleLine="true" />
        <EditTextPreference
            android:key="trusted_ips"
            android:title="Trusted IPs"
            android:summary="Comma-separated LAN IPs (e.g. an NVR like Frigate) that skip the login prompt entirely. Leave blank to require auth from everyone."
            android:defaultValue=""
            android:singleLine="true" />
        <ListPreference
            android:key="tls_version"
            android:title="TLS Version"
            android:summary="Automatically use the newest platform TLS, force TLS 1.2, or disable HTTPS"
            android:defaultValue="1.3"
            android:entries="@array/tls_version_entries"
            android:entryValues="@array/tls_version_values" />
        <Preference
            android:key="certificate_path"
            android:title="Custom TLS Certificate"
            android:summary="Select your own certificate"
            android:persistent="true" />
        <EditTextPreference
            android:key="certificate_password"
            android:title="Certificate Password"
            android:summary="Optional password for the TLS certificate"
            android:persistent="true"
            android:inputType="textPassword" />
        <Preference
            android:key="test_certificate"
            android:title="Test Certificate Setup"
            android:summary="Validate your certificate configuration"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Server">
        <CheckBoxPreference
            android:key="start_on_boot"
            android:title="Start on Boot"
            android:summary="Start the camera server automatically after the device restarts"
            android:defaultValue="false" />
        <EditTextPreference
            android:key="server_port"
            android:title="Streaming Port"
            android:summary="Port for the streaming server (default: 4444)"
            android:defaultValue="4444"
            android:inputType="number"
            android:singleLine="true" />
        <!-- Entries/entryValues are populated at runtime from this device's actual network
             interfaces (see SettingsFragment.refreshIpEntries) - they vary per device and per
             moment (e.g. whether Tailscale is currently connected), so a static array here
             wouldn't mean anything. -->
        <ListPreference
            android:key="display_ip"
            android:title="Server IP Address"
            android:summary="Which of this device's IP addresses to show/copy above - pin it to your Tailscale IP so it doesn't change when Wi-Fi does, e.g. when wiring this into Frigate"
            android:defaultValue="auto" />
    </PreferenceCategory>

    <!-- Same "resolution"/"fps" remote-control keys the web UI's own controls write - stream_res
         and stream_fps - so a change from either surface is visible on the other. -->
    <PreferenceCategory android:title="Stream Quality">
        <ListPreference
            android:key="stream_res"
            android:title="Resolution"
            android:defaultValue="auto"
            android:entries="@array/stream_resolution_entries"
            android:entryValues="@array/stream_resolution_values" />
        <EditTextPreference
            android:key="stream_fps"
            android:title="Frame Rate (fps)"
            android:defaultValue="30"
            android:inputType="number"
            android:singleLine="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Recording">
        <CheckBoxPreference
            android:key="recording_enabled"
            android:title="Enable On-Device Recording"
            android:summary="Allow saving recordings to this device. Turn off if you only want to stream live (e.g. to Frigate/Home Assistant) - the record button disappears from the web UI and the /record endpoints are disabled."
            android:defaultValue="true" />
        <Preference
            android:key="recording_storage_uri"
            android:title="Recording Storage Location"
            android:summary="Recordings are saved to Movies/AndroidIPCamera on the internal storage. Tap to pick a different folder, for example on an SD card."
            android:persistent="true"
            android:dependency="recording_enabled" />
        <Preference
            android:key="reset_recording_storage"
            android:title="Reset to Default Location"
            android:summary="Save recordings back to Movies/AndroidIPCamera"
            android:persistent="false"
            android:dependency="recording_enabled" />
    </PreferenceCategory>

    <PreferenceCategory android:title="App">
        <Preference
            android:key="exit_app"
            android:title="Exit App"
            android:summary="Stop the camera server and close the app" />
    </PreferenceCategory>
</PreferenceScreen>
